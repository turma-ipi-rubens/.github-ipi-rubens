# ==========================================
# CONFIGURAÇÕES GERAIS DE INFRAESTRUTURA DOCKER
# ==========================================

# Banco de Dados PostgreSQL Central
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_central_password_2026
POSTGRES_MULTIPLE_DATABASES=easy_english,eduhub,enlace,myserver,rack_plus,skillex

# Redis central (Utilizado pelo Channels/WebSockets)
REDIS_URL=redis://redis:6379/0

# ==========================================
# VARIÁVEIS DE AMBIENTE DOS PROJETOS (TCCS)
# ==========================================

# 1. repo-easy-english
EASY_ENGLISH_DB_URL=postgres://easy_english:easy_english@postgres:5432/easy_english
EASY_ENGLISH_SECRET_KEY=django-secure-secret-easy-english-2026

# 2. repo-edu-hub
EDUHUB_DB_URL=postgres://eduhub:eduhub@postgres:5432/eduhub
EDUHUB_SECRET_KEY=django-secure-secret-eduhub-2026
GEMINI_API_KEY=INSIRA_SUA_CHAVE_GEMINI_API_AQUI

# 3. repo-enlace
ENLACE_DATABASE_URL=postgresql://enlace:enlace@postgres:5432/enlace?schema=public
ENLACE_JWT_SECRET=node-secure-jwt-enlace-2026

# 4. repo-myserver
MYSERVER_DB_URL=postgres://myserver:myserver@postgres:5432/myserver
MYSERVER_SECRET_KEY=django-secure-secret-myserver-2026

# 5. repo-rack-plus
RACK_PLUS_DB_URL=postgres://rack_plus:rack_plus@postgres:5432/rack_plus
RACK_PLUS_SECRET_KEY=django-secure-secret-rack-plus-2026
RACK_PLUS_CHANNEL_LAYERS_REDIS_HOST=redis
RACK_PLUS_CHANNEL_LAYERS_REDIS_PORT=6379

# 6. repo-skillex
SKILLEX_DATABASE_URL=postgresql://skillex:skillex@postgres:5432/skillex?schema=public
SKILLEX_JWT_SECRET=node-secure-jwt-skillex-2026
